---
import Layout from "../../layouts/Layout.astro";
import IncidentList from "../../components/IncidentList.astro";
import { fmt, rubric, incidentsFor, allModels, defaultStanding, isLow, modelTitle, LEAGUES, CONFIDENCE_VIEWS } from "../../lib/data";

export function getStaticPaths() {
  return allModels().map((model: any) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const incidents = incidentsFor(model.slug);
const entries = incidents.flatMap((i: any) => i.models.filter((m: any) => m.slug === model.slug));
const aliases = [...new Set(entries.filter((m: any) => m.codename).map((m: any) => m.codename))];
// Standings per confidence view: a model can rank differently, or not at all, without its low-confidence reports.
const views = CONFIDENCE_VIEWS.map(({ key, data }) => {
  const standings = LEAGUES.map((l) => ({ ...l, row: data.boards[l.key].all.models.find((m: any) => m.slug === model.slug) })).filter((s) => s.row);
  return { key, standings, badges: [...new Set(standings.flatMap((s) => s.row.badges))] as string[] };
});
const onlyLow = incidents.every(isLow);
const hiddenCount = incidents.filter(isLow).length;
const standing = defaultStanding(model.slug);
const description = standing
  ? `${modelTitle(model)}: #${standing.row.rank} in the ${standing.league} with ${fmt(standing.row.score)} FBS.`
  : `${modelTitle(model)}: low-confidence reports only, so it isn't ranked by default.`;
---
<Layout title={modelTitle(model)} description={description} ogImage={`/og/${model.slug}.png`} revealWithoutJs={onlyLow}>
  {onlyLow && (
    <div class="panel low-notice" data-conf="confident">
      <p class="eyebrow">Low-confidence reports only · {model.org}</p>
      <h1>{model.name}</h1>
      <p>Every report about {model.name} is low confidence, so it's hidden while you're viewing high- and medium-confidence reports.</p>
      <button type="button" class="show-low-button" data-show-low>Show low-confidence reports</button>
    </div>
  )}
  <div data-conf={onlyLow ? "all" : undefined}>
  <section class="mugshot panel">
    <div class="placard">
      <div class="muted">{model.org}</div>
      <h1>{model.name}</h1>
      {aliases.length > 0 && <div class="muted">a.k.a. {aliases.join(", ")}</div>}
    </div>
    {views.map((v) => <div data-conf={v.key}>{v.badges.map((b) => <span class={`badge badge-${b}`} title={rubric.badges[b].description}>{rubric.badges[b].label}</span>)}</div>)}
  </section>

  {views.map((v) => (
    <div class="table-wrap" tabindex="0" role="region" aria-label="Table" data-conf={v.key}>
      <table>
        <thead><tr><th scope="col">League</th><th scope="col" class="num">Rank</th><th scope="col" class="num">FBS</th><th scope="col" class="num">Sentence-Years</th><th scope="col" class="num">Incidents</th></tr></thead>
        <tbody>{v.standings.map((s) => <tr><td>{s.label}</td><td class="num">#{s.row.rank}</td><td class="num score">{fmt(s.row.score)}</td><td class="num">{fmt(s.row.sentence_years)}</td><td class="num">{s.row.incidents.length}</td></tr>)}</tbody>
      </table>
    </div>
  ))}
  <p class="muted">Standings include alleged incidents.</p>

  <h2>Record</h2>
  {!onlyLow && hiddenCount > 0 && (
    <p class="muted hidden-count" data-conf="confident">{hiddenCount} low-confidence {hiddenCount === 1 ? "report" : "reports"} hidden. <button type="button" class="show-low-button" data-show-low>Show low-confidence reports</button></p>
  )}
  <IncidentList incidents={incidents} />
  </div>
</Layout>

<style>
  .low-notice { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .low-notice p { margin: 0; }
  .low-notice h1 { font-size: clamp(24px, 3vw, 34px); line-height: 1.15; }
  .mugshot {
    margin: 16px 0 24px;
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, var(--rule) 31px 32px);
  }
  .placard { display: inline-block; max-width: 100%; background: var(--ink); color: var(--paper); padding: 12px 20px; margin-bottom: 12px; font-family: var(--mono); overflow-wrap: anywhere; }
  .placard h1 { margin: 4px 0; }
  .placard .muted { color: var(--paper); opacity: 0.7; }
</style>
