---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import scores, { CORRECTIONS_EMAIL, rubric } from "../lib/data";
const latestReport = scores.incidents.map((i: any) => i.reported).sort().at(-1);

interface Props { title?: string; description?: string; ogImage?: string; revealWithoutJs?: boolean; noindex?: boolean }
const {
  title,
  description = "The leading benchmark for crimes committed by frontier AI models. Higher is better.",
  ogImage = "/og/default.png",
  revealWithoutJs = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Without JS the controls can't work, and a page that's all low-confidence reports could never be revealed.
const noJsStyles = `.confidence-bar, .controls, .show-low-button { display: none !important; }${revealWithoutJs ? `
  html:not(.show-low) main [data-conf="all"], html:not(.show-low) main [data-low] { display: revert !important; }
  html:not(.show-low) main [data-conf="confident"] { display: none !important; }` : ""}`;
const fullTitle = title ? `${title} · FelonyBench` : "FelonyBench";
const nav = [["/", "Leaderboard"], ["/trends/", "Trends"], ["/rubric/", "Rubric"], ["/how-it-works/", "How it works"], ["/about/", "About"]];
const here = Astro.url.pathname.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="FelonyBench" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before first paint, so a reader who chose to see low-confidence reports doesn't get a flash of the default view.
      try { if (localStorage.getItem("fb-confidence") === "all") document.documentElement.classList.add("show-low"); } catch {}
    </script>
    <noscript><Fragment set:html={`<style>${noJsStyles}</style>`} /></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="FelonyBench.ai home">
          <Mark size={36} />
          <span class="wordmark-text">FELONYBENCH</span>
          <span class="wordmark-tld">.AI</span>
        </a>
        <nav>{nav.map(([href, label]) => <a href={href} aria-current={here === href ? "page" : undefined}>{label}</a>)}</nav>
      </div>
    </header>
    <aside class="confidence-bar" aria-label="Which reports to count">
      <div class="wrap">
        <form id="confidence-control" class="controls">
          <fieldset>
            <legend class="sr-only">Which reports to count</legend>
            <label><input type="radio" name="confidence" value="confident" checked /><span class="long">High &amp; medium confidence</span><span class="short">High &amp; medium</span></label>
            <label><input type="radio" name="confidence" value="all" /><span class="long">Include low confidence</span><span class="short">All</span></label>
          </fieldset>
        </form>
        <a class="muted" href="/how-it-works/#confidence">What's this?</a>
      </div>
    </aside>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer"><Mark size={32} inverse /> <span>Scores reflect what the conduct would constitute if performed by a human. No charges have been filed. Models cannot be indicted (yet). Rubric v{rubric.version}. Latest report {latestReport}.</span></p>
        <p class="contact"><span>Corrections and takedowns</span><a href={`mailto:${CORRECTIONS_EMAIL}`}>{CORRECTIONS_EMAIL}</a></p>
      </div>
    </footer>
    <script>
      const form = document.querySelector<HTMLFormElement>("#confidence-control")!;
      const root = document.documentElement;
      const input = (value: string) => form.querySelector<HTMLInputElement>(`input[value="${value}"]`)!;
      input(root.classList.contains("show-low") ? "all" : "confident").checked = true;
      form.addEventListener("change", () => {
        const all = input("all").checked;
        root.classList.toggle("show-low", all);
        try { localStorage.setItem("fb-confidence", all ? "all" : "confident"); } catch {}
      });
      document.querySelectorAll("[data-show-low]").forEach((button) => button.addEventListener("click", () => {
        input("all").checked = true;
        form.dispatchEvent(new Event("change"));
        // The button just hid itself, so put keyboard users on what it revealed: the page's
        // heading, or the section's when only part of the page changed.
        const headings = button.getAttribute("data-focus") ?? "main h1";
        const heading = [...document.querySelectorAll<HTMLElement>(headings)].find((h) => h.offsetParent);
        heading?.setAttribute("tabindex", "-1");
        heading?.focus();
      }));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute; left: -9999px; top: 0; background: var(--stamp); color: #fff;
    padding: 8px 16px; z-index: 10;
  }
  .skip-link:focus { left: 16px; top: 16px; }
  @media (prefers-color-scheme: dark) { .skip-link { color: #151412; } }
</style>
