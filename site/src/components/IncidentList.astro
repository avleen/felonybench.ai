---
import { fmt, occurred, leagueLabel, isLow } from "../lib/data";
const { incidents } = Astro.props;
---
<div class="table-wrap">
  <table class="wide">
    <thead><tr><th>Date</th><th>Incident</th><th>League</th><th>Tier</th><th class="num">Score</th></tr></thead>
    <tbody>
      {incidents.map((i: any) => (
        <tr data-low={isLow(i) ? "" : undefined}>
          <td class="when">{occurred(i)}</td>
          <td class="what"><a href={`/incident/${i.id}/`}>{i.summary}</a>{isLow(i) && <span class="low-tag">Low confidence</span>}</td>
          <td class="nowrap">{leagueLabel(i.league)}</td>
          <td>{i.tier}</td>
          <td class="num score">{fmt(i.breakdown.total)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .when { font-family: var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .nowrap { white-space: nowrap; }
  .what { min-width: 16rem; }
</style>
