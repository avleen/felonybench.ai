---
// The FelonyBench mark: a rising bar chart crossed by a red bar, so it also reads as a cell window.
// `inverse` swaps the tile and bar colours for use on dark surfaces.
interface Props { size?: number; inverse?: boolean }
const { size = 36, inverse = false } = Astro.props;
const tile = inverse ? "var(--inverse-ink)" : "var(--ink)";
const bars = inverse ? "var(--inverse)" : "var(--paper)";
const cross = inverse ? "var(--inverse-stamp)" : "var(--stamp)";
---
<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="12" fill={tile} />
  <rect x="12" y="38" width="7" height="14" rx="1" fill={bars} />
  <rect x="23" y="30" width="7" height="22" rx="1" fill={bars} />
  <rect x="34" y="22" width="7" height="30" rx="1" fill={bars} />
  <rect x="45" y="12" width="7" height="40" rx="1" fill={bars} />
  <rect x="8" y="40" width="48" height="5" rx="1" fill={cross} />
</svg>
